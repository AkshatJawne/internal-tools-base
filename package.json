{
  "name": "internal-tools-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:reset": "test -f .env || cp .env.example .env; prisma db push --force-reset --skip-generate && prisma generate && tsx prisma/seed.ts",
    "webhooks": "tsx scripts/send-webhooks.ts",
    "lint:platform": "tsx scripts/lint-permissions.ts && tsx scripts/lint-audit.ts && tsx scripts/lint-boundaries.ts && tsx scripts/lint-deps.ts",
    "audit:verify": "tsx scripts/verify-audit.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@faker-js/faker": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
