DATABASE_URL="file:./dev.db"
# DEV ONLY secrets. Real deployments load these from the secrets manager.
SESSION_SECRET="dev-only-session-secret-change-me"
DEV_PASSWORD="acmepay-demo"  # local sign-in only; every seeded user has it, the sign-in page shows the demo account
KYC_WEBHOOK_SECRET="dev-only-kyc-webhook-secret"
# KYC_WEBHOOK_SECRET_PREVIOUS=  # set during key rotation; both keys verify until the vendor switches
PII_KEY="dev-only-pii-key-change-me"  # production: KMS data key, see src/kit/crypto.ts
APP_ENV="development"
