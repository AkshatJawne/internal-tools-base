// SQLite for local demo. Schema avoids SQLite-only features so `provider = "postgresql"` works in production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id     String  @id
  email  String  @unique
  name   String
  role   String
  team   String
  active Boolean @default(true)
  passwordHash String? // DEV ONLY local sign-in; null once OIDC is wired
}

// Append-only. DB triggers (prisma/audit-triggers.sql) reject UPDATE/DELETE.
// Hash-chained: hash = sha256(prevHash + canonical event). `pnpm audit:verify` walks the chain.
model AuditEvent {
  id         String   @id @default(cuid())
  seq        Int      @unique
  prevHash   String
  hash       String
  at         DateTime @default(now())
  actorId    String?
  actorName  String
  action     String
  appId      String?
  entityType String
  entityId   String
  before     String?
  after      String?
  reason     String?
  requestId  String

  @@index([entityType, entityId])
  @@index([at])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ApprovalRequest {
  id                 String    @id @default(cuid())
  kind               String
  appId              String
  entityType         String
  entityId           String
  summary            String
  payload            String
  makerId            String
  makerName          String
  makerReason        String?
  requiredPermission String
  status             String    @default("pending") // pending | approved | rejected | failed
  checkerId          String?
  checkerName        String?
  decisionReason     String?
  decidedAt          DateTime?
  executedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([status])
}

// Generic table backing config-defined ("generated") apps, like Dataverse rows.
model Record {
  id        String   @id @default(cuid())
  appId     String
  status    String
  data      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, status])
}

model KycCase {
  id             String    @id @default(cuid())
  externalRef    String    @unique
  firstName      String
  lastName       String
  email          String // encrypted (enc:v1:...) — see src/kit/crypto.ts
  emailMask      String
  country        String
  ssn            String // encrypted
  ssnMask        String
  dob            String // encrypted
  riskTier       String
  status         String    @default("new") // new | in_review | pending_signoff | approved | rejected | escalated
  assigneeId     String?
  idScore        Int
  sanctionsHit   Boolean   @default(false)
  pepHit         Boolean   @default(false)
  vendorPayload  String
  decision       String?
  decisionReason String?
  decisionNote   String?
  receivedAt     DateTime  @default(now())
  decidedAt      DateTime?
  documents      KycDocument[]

  @@index([status, riskTier])
}

model KycDocument {
  id     String  @id @default(cuid())
  caseId String
  kind   String
  svg    String
  case   KycCase @relation(fields: [caseId], references: [id])
}

model WebhookEvent {
  eventId    String   @id
  source     String
  receivedAt DateTime @default(now())
}

model ConnectorCall {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  connector      String
  operation      String
  appId          String
  status         String // ok | blocked | error
  dataClass      String   @default("internal") // internal | pii | money
  policyReason   String?
  request        String
  response       String?
  idempotencyKey String?  @unique
}

// Ops → engineering change requests. Tier 2 of self-service: a plain-English ask becomes a
// Devin PR that an engineer reviews. Status transitions are audited.
model ChangeRequest {
  id             String   @id @default(cuid())
  requesterId    String
  requesterName  String
  appId          String
  title          String
  description    String
  classification String // ui | logic | money_pii
  urgency        String // low | normal | high
  status         String   @default("open") // open | dispatched | pr_open | preview_ready | approved | deployed | declined
  prompt         String?
  prUrl          String?
  previewUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}
